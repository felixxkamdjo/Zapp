<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Zapp.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:radar="clr-namespace:Zapp.App.Views.Radar"
    xmlns:chats="clr-namespace:Zapp.App.Views.Chats"
    xmlns:broadcast="clr-namespace:Zapp.App.Views.Broadcast"
    xmlns:mesh="clr-namespace:Zapp.App.Views.Mesh"
    xmlns:settings="clr-namespace:Zapp.App.Views.Settings"
    Shell.FlyoutBehavior="Disabled"
    BackgroundColor="{StaticResource AppBackground}">

    <TabBar>
        <Tab Title="FAQ" Icon="dotnet_bot.png">
            <ShellContent
                Title="FAQ"
                ContentTemplate="{DataTemplate settings:FaqAssistantPage}"
                Route="FaqAssistantPage" />
        </Tab>
        <Tab Title="Radar" Icon="dotnet_bot.png">
            <ShellContent
                Title="Radar"
                ContentTemplate="{DataTemplate radar:RadarPage}"
                Route="RadarPage" />
        </Tab>
        <Tab Title="Chats" Icon="dotnet_bot.png">
            <ShellContent
                Title="Chats"
                ContentTemplate="{DataTemplate chats:ChatDetailPage}"
                Route="ChatDetailPage" />
        </Tab>
        <Tab Title="Broadcast" Icon="dotnet_bot.png">
            <ShellContent
                Title="Broadcast"
                ContentTemplate="{DataTemplate broadcast:BroadcastAlertsPage}"
                Route="BroadcastAlertsPage" />
        </Tab>
        <Tab Title="Relais" Icon="dotnet_bot.png">
            <ShellContent
                Title="Relais"
                ContentTemplate="{DataTemplate mesh:MeshQueuePage}"
                Route="MeshQueuePage" />
        </Tab>
    </TabBar>

</Shell>
