<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Zapp.App.ViewModels"
             xmlns:models="clr-namespace:Zapp.Core.Models;assembly=Zapp.Core"
             x:Class="Zapp.App.Views.Radar.RadarPage"
             x:DataType="vm:RadarViewModel"
             BackgroundColor="{StaticResource AppBackground}"
             Title="Découverte de pairs">

    <Grid RowDefinitions="Auto,240,Auto,*,Auto" Padding="20,16" RowSpacing="16">
        <!-- header navigation title -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Label Grid.Column="1" Text="Découverte de pairs" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" />
            <Label Grid.Column="2" Text="&#xf294;" FontFamily="MaterialIcons" TextColor="{StaticResource TextPrimary}" FontSize="20" />
        </Grid>

        <!-- central radar circular target graphics -->
        <Grid Grid.Row="1" WidthRequest="220" HeightRequest="220" HorizontalOptions="Center">
            <!-- outer circle -->
            <Border Stroke="{StaticResource SurfaceBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 110" BackgroundColor="Transparent" />
            <!-- middle circle -->
            <Border WidthRequest="150" HeightRequest="150" Stroke="{StaticResource SurfaceBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 75" BackgroundColor="Transparent" />
            <!-- inner core -->
            <Border WidthRequest="80" HeightRequest="80" Stroke="{StaticResource PrimaryAccent}" StrokeThickness="1" StrokeShape="RoundRectangle 40" BackgroundColor="#111E38">
                <Label Text="&#xe63e;" FontFamily="MaterialIcons" TextColor="{StaticResource PrimaryGlow}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- scan status text -->
        <VerticalStackLayout Grid.Row="2" Spacing="4" HorizontalOptions="Center">
            <Label Text="Scan en cours..." TextColor="{StaticResource SuccessGreen}" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
            <Label Text="Recherche des nœuds BLE à proximité" TextColor="{StaticResource TextMuted}" FontSize="12" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- discovered peers list -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding DiscoveredPeers}">
            <CollectionView.Header>
                <Label Text="PÉRIPHÉRIQUES DÉTECTÉS" TextColor="{StaticResource TextMuted}" FontSize="12" FontAttributes="Bold" Margin="0,0,0,8" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PeerNode">
                    <Border Style="{StaticResource ZappCard}" Margin="0,0,0,10" Padding="12">
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <!-- node avatar -->
                            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" BackgroundColor="{StaticResource SurfaceElevated}" Stroke="{StaticResource SurfaceBorder}">
                                <Label Text="NODE" TextColor="{StaticResource TextSecondary}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <!-- node details -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding DisplayName}" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding Rssi, StringFormat='{0} dBm'}" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                            </VerticalStackLayout>

                            <!-- pair action button -->
                            <Button Grid.Column="2" Text="Appairer" HeightRequest="36" Padding="16,0" CornerRadius="18" BackgroundColor="{StaticResource PrimaryAccent}" FontSize="13" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- toggle scan action button -->
        <Button Grid.Row="4" 
                Text="Arrêter le scan" 
                Command="{Binding ToggleScanCommand}" 
                Style="{StaticResource ZappPrimaryButton}" />
    </Grid>
</ContentPage>
